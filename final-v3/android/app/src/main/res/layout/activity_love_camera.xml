<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/love_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/love_camera_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="\u2715" />

    <Button
        android:id="@+id/love_camera_flip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="\ud83d\udd04" />

    <!-- Bottom overlay: the answer/solution panel on top, and a chat input
         row underneath it. The Activity uses adjustResize, so when the
         keyboard opens this whole block rides up above it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC1A1A2E">

        <!-- Height is capped in code (MaxHeightScrollView) so a long
             worked-out solution scrolls instead of covering the camera. -->
        <com.aureon.ai.MaxHeightScrollView
            android:id="@+id/love_camera_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/love_camera_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:text="Point the camera at a question…" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="32dp">

                    <TextView
                        android:id="@+id/love_camera_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <ProgressBar
                        android:id="@+id/love_camera_spinner"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|top"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </com.aureon.ai.MaxHeightScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Back to live scanning after chatting -->
            <Button
                android:id="@+id/love_camera_scan_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#00000000"
                android:textSize="20sp"
                android:text="\ud83d\udcf7" />

            <EditText
                android:id="@+id/love_camera_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:hint="Type a message…"
                android:textColorHint="#88FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="12dp"
                android:singleLine="true"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences" />

            <Button
                android:id="@+id/love_camera_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:text="\u27a4" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
