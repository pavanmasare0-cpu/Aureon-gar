<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aureon_deep_space_bg">

    <!-- Full-screen cosmic/nebula background, edge-to-edge behind everything. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/aureon_cosmic_bg"
        android:contentDescription="@null" />

    <!-- Orb video — unchanged player/logic, just repositioned: centered
         horizontally, sitting in the middle/lower-middle of the screen,
         slightly smaller than before so it reads as foreground over the
         cosmic background rather than filling the whole view. -->
    <TextureView
        android:id="@+id/aureon_orb_texture"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:layout_marginTop="60dp" />

    <!-- Text sits below the orb, near the bottom. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/aureon_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listening…"
            android:textColor="#FFD54A"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/aureon_response_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
