<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live camera mode: reads a question visible on screen/paper and
             shows Aureon's answer in a side panel in real time. Standalone
             screen, launched like any other tool action — see
             AureonAgentActions.openLoveCamera(). -->
        <activity
            android:name=".LoveCameraActivity"
            android:label="Love Camera"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Aureon system-wide assistant: entry point Android binds to once
             this app is set as the phone's Default Digital Assistant. -->
        <service
            android:name=".AureonVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/interaction_service" />
        </service>

        <!-- Draws the floating overlay whenever the assistant is invoked. -->
        <service
            android:name=".AureonVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true"
        />

        <!-- Bridge for typing dictated text and performing UI actions (find
             contact, type message, tap Send) inside other apps like
             WhatsApp/Instagram. The user must explicitly enable it in
             Android Accessibility settings; nothing runs until they do,
             and every send still goes through the voice confirmation step
             in AureonVoiceInteractionSession before anything is tapped. -->
        <service
            android:name=".AureonAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aureon_accessibility_config" />
        </service>

        <!-- Announces the caller's name ("Pavan is calling") the moment the
             phone starts ringing. Independent of Default Assistant status —
             registered here as a plain broadcast receiver, not tied to the
             voice-interaction session. This is the manifest-declared
             backup path; AureonCallListenerService is the primary,
             more-reliable path on aggressive OEM skins. -->
        <receiver
            android:name=".AureonCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Persistent foreground service, kept alive by its own low-
             priority notification, whose dynamically-registered receiver
             is far less likely to be skipped by ColorOS/Realme-style
             background-kill than the static receiver above on its own. -->
        <service
            android:name=".AureonCallListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Announces caller name via text-to-speech when a call rings" />
        </service>

        <!-- JARVIS-style proactive check-ins — fired by self-rescheduling
             AlarmManager alarms (daily + "been quiet a while"), never by
             another app, so this doesn't need to be exported. -->
        <receiver
            android:name=".AureonProactiveScheduler$AureonProactiveReceiver"
            android:exported="false" />
    </application>

    <!-- Required since Android 11 (API 30): without this, the system hides
         almost every other app from PackageManager queries by default
         ("package visibility"). This lets Aureon see any app with a
         launcher icon, so open_app / send-message can find WhatsApp,
         Instagram, etc. by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_VOICE_INTERACTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
