PORT=3000
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
OWNER_CODE=

# --- Ava (flying assistant) — all optional ---
SENTINEL_OWNER_CODE=
# AVA_LEARN=off
# AVA_LEARN_INTERVAL_MIN=90
# AVA_TOPICS=Gemini API changes, Android WebView updates
# AVA_SCREEN=off
# AVA_SCREEN_TTL_DAYS=14
# AVA_SCREEN_MAX_PER_HOUR=90
# AVA_SCOUT=off
# AVA_SCOUT_INTERVAL_MIN=240
# AVA_REFLECT=off
# AVA_EMAIL_DISCOVERIES=off
# AVA_TZ=Asia/Kolkata

# --- v12: APK Studio (AI writes an app -> GitHub Actions builds the APK) ---
# GITHUB_TOKEN: fine-grained token for the repo with Contents = Read&Write and Actions = Read&Write
# (Sentinel's GitHub fixes use the same token).
GITHUB_TOKEN=
APK_GH_REPO=owner/repo
# APK_APPS_BRANCH=apk-apps

# --- Apps & Automation: app tokens are stored encrypted ---
# Encryption needs SENTINEL_ENC_KEY (any long random string) or SENTINEL_OWNER_CODE.
SENTINEL_ENC_KEY=

# v33: keys — koi bhi number: GEMINI_API_KEY, GEMINI_API_KEY_2 ... _99 aur GROQ_API_KEY, GROQ_API_KEY_2 ...
# Video generation (optional): VEO_MODELS=veo-3.1-generate-preview,veo-3.0-generate-001,veo-3.0-fast-generate-001,veo-2.0-generate-001
